{
  "name": "Workbench Dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  // 开发容器说明（仿 openai/codex devcontainer 分层思路的轻量版）：
  // - 镜像仅提供 Node 20 + pnpm + 基础工具；仓库依赖在 postCreateCommand 安装，
  //   与本地开发流程一致（pnpm install），镜像不携带依赖层。
  // - 三个 workspace（根 / relay / client）各自安装，与 CI 的 setup action 对齐。
  "postCreateCommand": "pnpm install --frozen-lockfile && pnpm --dir relay install --frozen-lockfile && pnpm --dir client install --frozen-lockfile",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "davidanson.vscode-markdownlint"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  }
}
